/* FreeCAD-inspired light theme */
QWidget {
    background-color: #ececec;
    color: #222222;
    font-family: "Segoe UI", "Ubuntu", sans-serif;
    font-size: 9pt;
}

QMainWindow, QDialog {
    background-color: #ececec;
}

QGroupBox {
    border: 1px solid #b8b8b8;
    border-radius: 3px;
    margin-top: 10px;
    padding-top: 14px;
    font-weight: bold;
    color: #333333;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QPushButton {
    background-color: #d4d4d4;
    border: 1px solid #9a9a9a;
    border-radius: 2px;
    padding: 4px 14px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #c8daf5;
    border-color: #4a90d9;
}

QPushButton:pressed {
    background-color: #a8c4e8;
}

QPushButton:checked {
    background-color: #4a90d9;
    color: white;
    border-color: #2d6cb5;
}

QRadioButton, QCheckBox {
    spacing: 8px;
    color: #222222;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #707070;
    background: #ffffff;
}

QRadioButton::indicator:hover {
    border-color: #4a90d9;
    background: #f0f6ff;
}

QRadioButton::indicator:checked {
    border: 2px solid #1a5fb4;
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        fx: 0.5, fy: 0.5,
        stop: 0 #1a5fb4,
        stop: 0.42 #1a5fb4,
        stop: 0.43 #ffffff,
        stop: 1 #ffffff
    );
}

QRadioButton::indicator:checked:hover {
    border-color: #2d6cb5;
}

QRadioButton::indicator:disabled {
    border-color: #b0b0b0;
    background: #e8e8e8;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 2px solid #707070;
    background: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #4a90d9;
    background: #f0f6ff;
}

QCheckBox::indicator:checked {
    border: 2px solid #1a5fb4;
    background-color: #2d6cb5;
    image: none;
}

QCheckBox::indicator:checked:hover {
    border-color: #2d6cb5;
    background-color: #4a90d9;
}

QCheckBox::indicator:disabled {
    border-color: #b0b0b0;
    background: #e8e8e8;
}

QMenuBar {
    background-color: #e0e0e0;
    border-bottom: 1px solid #b0b0b0;
}

QMenuBar::item:selected {
    background-color: #c8daf5;
}

QStatusBar {
    background-color: #e0e0e0;
    border-top: 1px solid #b0b0b0;
}

QLabel#voiceStatus {
    color: #2d6cb5;
    font-style: italic;
}

/* --- FreeCAD toolbar buttons transparent + hover --- */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px;
    margin: 0 2px;
}

QToolButton:hover {
    background-color: #c8daf5;
    border: 1px solid #9a9a9a;
}

QToolButton:pressed {
    background-color: #a8c4e8;
}

QToolButton:checked {
    background-color: #d0d0d0;
    border: 1px solid #9a9a9a;
}

QToolButton:checked:hover {
    background-color: #c8daf5;
}

QToolButton::menu-button {
    border: 1px solid transparent;
    width: 15px;
}

QToolButton::menu-arrow {
    image: none;
    height: 13px;
}

/* --- Start page buttons: small border per mode --- */
#CreateNewRow > QPushButton {
    background-color: transparent;
    background-image: none;
    border: 1px solid #b8b8b8;
    border-radius: 3px;
    min-width: 0;
    padding: 3px;
}

#CreateNewRow > QPushButton QLabel {
    background-color: transparent;
}

#CreateNewRow > QPushButton:hover {
    background-color: #c8daf5;
    background-image: none;
    border: 1px solid #4a90d9;
}

/* --- Report view: dark text on light background --- */
QTextEdit {
    color: #222222;
}

/* --- FreeCAD panel separators --- */
QSplitter::handle {
    background-color: #b8b8b8;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #4a90d9;
}

/* --- Tree / list separators --- */
QTreeView, QTreeView::item {
    border: none;
}

QHeaderView::section {
    background-color: #e0e0e0;
    border: 1px solid #b8b8b8;
    padding: 4px;
}
