/* FreeCAD-inspired dark theme */
QWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
    font-family: "Segoe UI", "Ubuntu", sans-serif;
    font-size: 9pt;
}

QMainWindow, QDialog {
    background-color: #1e1e1e;
}

QGroupBox {
    border: 1px solid #444444;
    border-radius: 3px;
    margin-top: 10px;
    padding-top: 14px;
    font-weight: bold;
    color: #cccccc;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QPushButton {
    background-color: #333333;
    border: 1px solid #555555;
    border-radius: 2px;
    padding: 4px 14px;
    min-height: 22px;
    color: #e0e0e0;
}

QPushButton:hover {
    background-color: #3d5a80;
    border-color: #5a9fd4;
}

QPushButton:pressed {
    background-color: #2a4060;
}

QPushButton:checked {
    background-color: #4a7ab8;
    color: white;
    border-color: #3a6aa8;
}

QRadioButton, QCheckBox {
    spacing: 8px;
    color: #e8e8e8;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #9a9a9a;
    background: #2a2a2a;
}

QRadioButton::indicator:hover {
    border-color: #6ab0f5;
    background: #333333;
}

QRadioButton::indicator:checked {
    border: 2px solid #6ab0f5;
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.5,
        fx: 0.5, fy: 0.5,
        stop: 0 #6ab0f5,
        stop: 0.42 #6ab0f5,
        stop: 0.43 #2a2a2a,
        stop: 1 #2a2a2a
    );
}

QRadioButton::indicator:checked:hover {
    border-color: #8ec5ff;
}

QRadioButton::indicator:disabled {
    border-color: #555555;
    background: #1a1a1a;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 2px solid #9a9a9a;
    background: #2a2a2a;
}

QCheckBox::indicator:hover {
    border-color: #6ab0f5;
    background: #333333;
}

QCheckBox::indicator:checked {
    border: 2px solid #6ab0f5;
    background-color: #4a7ab8;
}

QCheckBox::indicator:checked:hover {
    border-color: #8ec5ff;
    background-color: #5a9fd4;
}

QCheckBox::indicator:disabled {
    border-color: #555555;
    background: #1a1a1a;
}

QMenuBar {
    background-color: #252525;
    border-bottom: 1px solid #444444;
    color: #e0e0e0;
}

QMenuBar::item:selected {
    background-color: #3d5a80;
}

QStatusBar {
    background-color: #252525;
    border-top: 1px solid #444444;
    color: #cccccc;
}

QLabel#voiceStatus {
    color: #6ab0f5;
    font-style: italic;
}
