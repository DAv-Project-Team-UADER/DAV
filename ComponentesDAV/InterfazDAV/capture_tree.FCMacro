# capture_tree.FCMacro
# Macro en modo escucha - se ejecuta UNA VEZ y se queda esperando señales

import FreeCADGui as Gui
import os
import json
from PySide import QtCore, QtGui

# Cargar rutas de forma dinámica
appdata = os.environ.get("APPDATA", "")
if not appdata:
    appdata = os.path.expanduser("~")

config_path = os.path.join(appdata, "FreeCAD", "dav_paths.json")

signal_file = None
image_path = None

if os.path.exists(config_path):
    try:
        with open(config_path, 'r', encoding='utf-8') as f:
            paths = json.load(f)
            signal_file = paths.get("signal_file")
            image_path = paths.get("image_path")
    except Exception as e:
        print("Error al cargar config dav_paths.json: " + str(e))

# Fallbacks si no existen
if not signal_file:
    signal_file = os.path.join(os.path.dirname(__file__), "capture_signal.json")
if not image_path:
    image_path = os.path.join(os.path.dirname(__file__), "tree_capture.png")

waiting = False

def capture_tree():
    """Captura el árbol del modelo de FreeCAD"""
    try:
        mw = Gui.getMainWindow()
        if not mw:
            return {"success": False, "error": "No main window"}
        
        # Buscar el Combo View
        combo_view = None
        for dock in mw.findChildren(QtGui.QDockWidget):
            if "Combo" in dock.windowTitle() or "Model" in dock.windowTitle():
                combo_view = dock
                break
        
        if combo_view:
            pixmap = combo_view.grab()
        else:
            # Fallback: buscar TreeView más grande
            all_tv = mw.findChildren(QtGui.QTreeView)
            best = None
            best_area = 0
            for tv in all_tv:
                if tv.objectName() != "propertyEditorView":
                    area = tv.width() * tv.height()
                    if area > best_area:
                        best_area = area
                        best = tv
            if best:
                pixmap = best.grab()
            else:
                return {"success": False, "error": "No tree view found"}
        
        pixmap.save(image_path, "PNG")
        return {"success": True, "path": image_path}
    except Exception as e:
        return {"success": False, "error": str(e)}

def check_signal():
    global waiting
    if waiting:
        return
    
    if os.path.exists(signal_file):
        try:
            with open(signal_file, 'r') as f:
                data = json.load(f)
            
            if data.get("command") == "capture":
                waiting = True
                print("Senal recibida, capturando...")
                result = capture_tree()
                with open(signal_file, 'w') as f:
                    json.dump({"status": "done", "result": result}, f)
                waiting = False
        except:
            pass

# Iniciar timer
timer = QtCore.QTimer()
timer.timeout.connect(check_signal)
timer.start(500)  # Revisar cada 0.5 segundos

print("="*50)
print("Macro en modo escucha iniciada")
print("Esperando senal en:", signal_file)
print("Imagen se guardara en:", image_path)
print("="*50)